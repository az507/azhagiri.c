pipeline {
    agent any
    environment {
        PATH = "C:\\Program Files\\Docker\\Docker\\resources\\bin;${env.PATH}"
        KUBECONFIG = 'C:\\Users\\pugaz\\.kube\\config'
        NEW_IMAGE = 'nginx:1.25'
    }
    stages {
        stage('Deploy current version') {
            steps {
                bat 'kubectl apply -f set07-update-image/deployment.yaml'
                bat 'kubectl rollout status deployment/update-app --timeout=120s'
            }
        }
        stage('Update to new image') {
            steps {
                bat 'kubectl set image deployment/update-app nginx=%NEW_IMAGE%'
                bat 'kubectl rollout status deployment/update-app --timeout=120s'
            }
        }
        stage('Verify new image') {
            steps {
                bat 'kubectl get deployment update-app -o jsonpath="{.spec.template.spec.containers[0].image}"'
                bat 'kubectl rollout history deployment/update-app'
                bat 'kubectl get pods -l app=update-app'
            }
        }
    }
    post {
        success { echo 'Pipeline succeeded!' }
        failure { echo 'Pipeline failed. Check the console output.' }
    }
}
