pipeline {
    agent any
    environment {
        PATH = "C:\\Program Files\\Docker\\Docker\\resources\\bin;${env.PATH}"
        KUBECONFIG = 'C:\\Users\\pugaz\\.kube\\config'
    }
    stages {
        stage('Deploy sample app') {
            steps {
                bat 'kubectl apply -f set02-deploy-sample-app/deployment.yaml'
            }
        }
        stage('Verify') {
            steps {
                bat 'kubectl rollout status deployment/sample-java-app --timeout=180s'
                bat 'kubectl get pods -l app=sample-java-app'
                bat 'kubectl logs -l app=sample-java-app --tail=5'
            }
        }
    }
    post {
        success { echo 'Pipeline succeeded!' }
        failure { echo 'Pipeline failed. Check the console output.' }
    }
}
