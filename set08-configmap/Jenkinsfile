pipeline {
    agent any
    environment {
        PATH = "C:\\Program Files\\Docker\\Docker\\resources\\bin;${env.PATH}"
        KUBECONFIG = 'C:\\Users\\pugaz\\.kube\\config'
    }
    stages {
        stage('Deploy ConfigMap and app') {
            steps {
                bat 'kubectl apply -f set08-configmap/k8s.yaml'
                bat 'kubectl rollout status deployment/config-app --timeout=120s'
            }
        }
        stage('Verify ConfigMap') {
            steps {
                bat 'kubectl get configmap app-config'
                bat 'kubectl exec deploy/config-app -- printenv APP_MESSAGE'
            }
        }
        stage('Test Service (in-cluster HTTP check)') {
            steps {
                retry(3) {
                    sleep 3
                    bat 'kubectl run curl-test-%BUILD_NUMBER% --rm -i --restart=Never --image=curlimages/curl:8.8.0 --command -- curl -s -I http://config-svc'
                }
            }
        }
    }
    post {
        success { echo 'Pipeline succeeded!' }
        failure { echo 'Pipeline failed. Check the console output.' }
    }
}
