pipeline {
    agent any
    environment {
        PATH = "C:\\Program Files\\Docker\\Docker\\resources\\bin;${env.PATH}"
        KUBECONFIG = 'C:\\Users\\pugaz\\.kube\\config'
    }
    stages {
        stage('Deploy app with readiness probe') {
            steps {
                bat 'kubectl apply -f set10-readiness-probe/deployment.yaml'
                bat 'kubectl rollout status deployment/probe-app --timeout=120s'
            }
        }
        stage('Verify probe') {
            steps {
                bat 'kubectl get pods -l app=probe-app'
                bat 'kubectl describe deployment probe-app'
            }
        }
    }
    post {
        success { echo 'Pipeline succeeded!' }
        failure { echo 'Pipeline failed. Check the console output.' }
    }
}
